---
import "../styles/global.css";
---

<div id="container" class="flex items-center justify-center min-h-screen py-20">
	<main>
		<section id="hero" class="hero flex items-center justify-center gap-6 md:gap-8 lg:gap-10">
			<img src="/profilepic2.jpeg" alt="Profilna slika" class="w-32 h-36 rounded-full border-4 border-white shadow-lg md:w-48 md:h-52" />
			<div class="intro ml-2 flex flex-col border-2 p-1 border-white backdrop: bg-white md:ml-46 ml-8 md:p-4">
				<h1 class="text-l font-bold md:text-3xl">Andrea Gazibarić</h1>
				<h2 class="text-gray-500 text-sm md:text-xl">Student</h2>
				<div class="mt-2 flex justify-center gap-3 md:gap-5">
					<a href="https://www.linkedin.com/in/andrea-gazibaric" target="_blank" class="text-gray-800 transition-transform duration-200 hover:scale-110 hover:text-gray-900 text-xl md:text-3xl">
						<i class="fab fa-linkedin"></i>
					</a>
					<a href="https://github.com/andreagazibaric" target="_blank" class="text-gray-800 transition-transform duration-200 hover:scale-110 hover:text-gray-900 text-xl md:text-3xl">
						<i class="fab fa-github"></i>
					</a>
				</div>
			</div>
		</section>

		<section id="about" class="mt-30">
			<h2 class="text-3xl font-bold text-center">About me</h2>
			<div class="mx-auto mt-6 max-w-4xl px-4">
				<p class="text-center text-gray-800 text-sm md:text-lg lg:text-xl md:p-0 leading-relaxed">
					Hi, my name is Andrea Gazibarić and I am currently a final-year graduate student at the Faculty of Electrical Engineering and Computing in Zagreb.<br />
					I have a strong theoretical foundation in object-oriented programming languages and web development.<br />
					I have experience with Java, C, Python, HTML/CSS/JavaScript, and SQL, as well as knowledge and experience with frameworks and environments such as React.js, Spring Boot, FastAPI, and Astro.<br />
					Through my education and project work, I have developed a solid understanding of working with REST APIs and gained experience using tools such as Git and Postman.<br />
					I am a positive and communicative person who is eager to take on new challenges, expand my existing knowledge and develop new skills.
				</p>
			</div>
		</section>

		<section id="skills" class="mt-30">
			<h2 class="text-3xl font-bold text-center">Skills and certificates</h2>
			<div class="mx-auto mt-10 w-full max-w-4xl px-4">
				<div class="flex flex-wrap justify-center gap-2 lg:gap-8 md:gap-6 mb-8 mt-8">
					<div class="flex-1 text-center p-6 border-2 rounded-xl border-gray-700" style="background-color: rgb(237, 232, 243);">
						<h2 class="text-xl text-gray-600 font-bold">Skills</h2>
						<div class="flex flex-wrap flex-row gap-8 justify-around text-start mt-4">
							<article>
								<div class="flex items-center space-x-2">
									<i class="fab fa-java"></i>
									<h3 class="font-bold">Java</h3>
								</div>
							</article>
							<article>
								<div class="flex items-center space-x-2">
									<i class="devicon-c-plain"></i>
									<h3 class="font-bold">C</h3>
								</div>
							</article>
							<article>
								<div class="flex items-center space-x-2">
									<i class="fa-solid fa-database"></i>
									<h3 class="font-bold">SQL</h3>
								</div>
							</article>
							<article>
								<div class="flex items-center space-x-2">
									<i class="fab fa-html5"></i>
									<h3 class="font-bold">HTML</h3>
								</div>
							</article>
							<article>
								<div class="flex items-center space-x-2">
									<i class="fab fa-css3-alt"></i>
									<h3 class="font-bold">CSS</h3>
								</div>
							</article>
							<article>
								<div class="flex items-center space-x-2">
									<i class="fab fa-js"></i>
									<h3 class="font-bold">JS</h3>
								</div>
							</article>
							<article>
								<div class="flex items-center space-x-2">
									<i class="devicon-git-plain"></i>
									<h3 class="font-bold">Git</h3>
								</div>
							</article>
							<article>
								<div class="flex items-center space-x-2">
									<i class="devicon-postman-plain"></i>
									<h3 class="font-bold">Postman</h3>
								</div>
							</article>
						</div>
					</div>
					<div class="flex-1 text-center p-6 border-2 rounded-xl border-gray-700" style="background-color: rgb(237, 232, 243);">
						<h2 class="text-xl text-gray-600 font-bold">Certificates</h2>
						<div class="flex flex-wrap flex-row gap-10 justify-around text-start mt-4">
							<article>
								<div class="">
									<i class="fab fa-aws mr-1"></i>
									<a href="https://www.credly.com/badges/a44be2e7-fa44-4c6b-9bd8-f545b161c450/public_url" target="_blank" class="font-bold">AWS Certified Cloud Practitioner</a>
									<p class="italic text-gray-500 text-sm text-end">2025</p>
								</div>
							</article>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="experience" class="mt-30">
			<h2 class="text-3xl font-bold text-center">Experience</h2>
			<div class="mx-auto mt-10 w-full max-w-4xl px-4">
				<div class="flex justify-center rounded-xl border-2 border-gray-700 bg-white p-6 text-left md:p-8" style="background-color: rgb(250, 248, 251);">
					<div class="flex w-full items-start gap-3 md:gap-4">
						<i class="fa-solid fa-fire mt-1 text-2xl text-orange-500"></i>
						<div class="flex-1">
							<h3 class="text-xl font-bold text-gray-800 md:text-2xl">Ignit Group</h3>
							<div class="mt-1 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
								<p class="text-base font-semibold text-gray-600 md:text-lg">Junior Developer</p>
								<p class="text-sm font-medium text-gray-500 md:text-base">May 2026 - Present</p>
							</div>
							<p class="mt-3 text-sm leading-relaxed text-gray-700 md:text-base">
								Contributed to the development and improvement of Ignit’s internal web platform, working on frontend and backend tasks, 
								implementing new features and optimizing existing functionality in a collaborative team environment.
								Participating in image annotations and data labeling tasks for machine learning projects, 
								ensuring high-quality and accurate data for training models. Taking part in code reviews, collaborating with team members 
								and gaining practical experience in software development processes and best practices.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="contact" class="mt-30">
			<h2 class="text-3xl font-bold text-center">Contact</h2>
			<div class="flex justify-center mt-20">
			<div class="flex justify-around text-center gap-6 p-2 md:gap-24 md:p-6 border-2 rounded-xl border-gray-600" style="background-color: rgb(228, 218, 235);">
				<article>
					<div class="flex items-center space-x-2">
						<i class="far fa-envelope"></i>
						<h3 class="text-sm font-bold">andrea2011g@gmail.com</h3>
					</div>
				</article>
				<article>
					<div class="flex items-center space-x-2">
						<i class="fab fa-linkedin"></i>
						<a href="https://www.linkedin.com/in/andrea-gazibaric" target="_blank" class="text-sm font-bold">andrea-gazibaric</a>
					</div>
				</article>
				</div>
			</div>
		</section>

	</main>
</div>

